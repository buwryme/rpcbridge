[Unit]
Description=Discord RPC to OAuth2 presence bridge
Documentation=https://git.buwryy.net/buwryy/rpcbridge
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/rpcbridge run
Restart=on-failure
RestartSec=3
Environment=RUST_LOG=rpcbridge=info

[Install]
WantedBy=default.target
